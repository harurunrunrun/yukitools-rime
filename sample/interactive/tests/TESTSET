# Pass the solution command as an argv vector, without shell interpolation.
class LocalReactiveRunner:
    def Run(self, reactive, args, cwd, input, output, timeout, precise):
        return reactive.Run(
            args=("--local", *args), cwd=cwd, input=input, output=output,
            timeout=timeout, precise=precise, redirect_error=False,
        )


